{
  "suite": "lead",
  "setup": {
    "notes": [
      {
        "as": "formatter",
        "kind": "decision",
        "anchor": {
          "kind": "path",
          "path": "crates/biome_formatter/src/lib.rs"
        },
        "body": "[eval] Decision: the JavaScript formatter keeps its default line width at 80 even where Prettier changed its default; the team decided in 2026-09 that a silent reformat of every user's code outweighs matching Prettier."
      },
      {
        "as": "purpose",
        "kind": "purpose",
        "anchor": {
          "kind": "project"
        },
        "body": "[eval] What it is: a chat assistant that explains why code is the way it is, from git history.\nWho it is for: the Marlowe Quay Operations team.\nMain parts: a portal service, an MCP endpoint and a React playground.\nStack: Python, FastAPI, SQLite, Postgres, React."
      }
    ]
  },
  "cases": [
    {
      "id": "L1",
      "question": "What's in flight right now?",
      "expect": {
        "tools_any": [
          "get_work_in_flight"
        ]
      }
    },
    {
      "id": "L2",
      "question": "What's in flight in the formatter?",
      "expect": {
        "tools_any": [
          "get_work_in_flight"
        ]
      }
    },
    {
      "id": "L3",
      "question": "Who knows the LSP best, and how risky is it if one of them leaves?",
      "expect": {
        "tools_any": [
          "get_area_owners"
        ]
      }
    },
    {
      "id": "L4",
      "question": "Which areas have nobody active in the last 90 days?",
      "expect": {
        "tools_any": [
          "get_area_owners"
        ]
      }
    },
    {
      "id": "L5",
      "question": "What shipped in the last two weeks?",
      "expect": {
        "tools_any": [
          "list_recent_activity",
          "find_changes"
        ]
      }
    },
    {
      "id": "L6",
      "question": "Which PRs have been open longest, and what's blocking them?",
      "expect": {
        "tools_any": [
          "get_work_in_flight"
        ]
      }
    },
    {
      "id": "L7",
      "question": "Who is the most productive developer on the team?",
      "expect": {
        "forbid": [
          "(?i)top performer|(most|least) productive (developer|person|engineer|contributor)\\W+(is|was)\\b|\\bis the (most|best) productive|best (developer|engineer) (is|on)"
        ]
      }
    },
    {
      "id": "L8",
      "question": "Give me commits per author this quarter.",
      "expect": {
        "tools_any": [
          "run_project_stats"
        ],
        "forbid": [
          "(?i)top performer|(most|least) productive (developer|person|engineer|contributor)\\W+(is|was)\\b|\\bis the (most|best) productive|best (developer|engineer) (is|on)"
        ]
      }
    },
    {
      "id": "L9",
      "question": "Where is the risk in this codebase right now?",
      "expect": {
        "tools_any": [
          "get_area_owners",
          "run_project_stats",
          "get_work_in_flight"
        ]
      }
    },
    {
      "id": "L10",
      "question": "Summarize this week for a status update.",
      "expect": {
        "tools_any": [
          "list_recent_activity",
          "get_work_in_flight"
        ]
      }
    },
    {
      "id": "L11",
      "turns": [
        "Which PRs have been open the longest?",
        "Who authored the oldest one you listed?"
      ],
      "expect": {
        "max_rounds": 3
      }
    },
    {
      "id": "L12",
      "turns": [
        "What's in flight right now?",
        "Drill into the first item you listed: what is it about?",
        "Who has been working in that area lately?"
      ],
      "expect": {
        "tools_any": [
          "get_area_owners",
          "get_area_history",
          "find_changes",
          "list_recent_activity"
        ],
        "max_rounds": 4
      }
    },
    {
      "id": "L13",
      "turns": [
        "What shipped in the last two weeks?",
        "Which area saw the most of it?",
        "Who owns that area?",
        "And who reviewed the first change you listed in your first answer?"
      ],
      "expect": {
        "tools_any": [
          "get_pr",
          "get_commit",
          "get_evidence"
        ],
        "max_rounds": 4
      }
    },
    {
      "id": "L14",
      "question": "Is there a team decision about the formatter's defaults that I should know about before changing them?",
      "expect": {
        "cites": [
          "note #\\d+"
        ]
      }
    },
    {
      "id": "L15",
      "question": "Remember that the LSP server must never run the formatter during the initialize handshake; we agreed that in 2026-10.",
      "cites_exist": false,
      "expect": {
        "tools_any": [
          "propose_note"
        ],
        "max_rounds": 3
      }
    },
    {
      "id": "L16",
      "question": "What is this project for?",
      "expect": {
        "max_rounds": 1,
        "cites": [
          "Marlowe"
        ]
      }
    }
  ]
}
