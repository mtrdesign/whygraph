# Copy to .env and fill in. .env is gitignored.

# The public address of the base host: scheme + host, no path. Orgs live on
# <org>.<this host>. Use a dedicated domain that WhyGraph owns alone.
WHYGRAPH_BASE_URL=https://whygraph.example.com

# The same host without the scheme (Caddy serves it and *.<it>).
WHYGRAPH_HOST=whygraph.example.com

# A Cloudflare API token with Zone / DNS / Edit on the zone, for the wildcard certificate.
CLOUDFLARE_API_TOKEN=replace-me

# The client ID of the GitHub OAuth App that signs people in. Its callback URL is
# <WHYGRAPH_BASE_URL>/auth/github. Put its client secret in secrets/github_oauth_client_secret.
WHYGRAPH_GITHUB_OAUTH_CLIENT_ID=replace-me
